    "definitions": {
        "schemas.AccountBaseSchema": {
            "type": "object",
            "properties": {
                "colorHex": {
                    "type": "string",
                    "example": "#1E88E5"
                },
                "currency": {
                    "type": "string",
                    "example": "uah"
                },
                "description": {
                    "type": "string",
                    "example": "Main salary card"
                },
                "id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "name": {
                    "type": "string",
                    "example": "Monobank card"
                }
            }
        },
        "schemas.AccountSchema": {
            "type": "object",
            "properties": {
                "amount": {
                    "$ref": "#/definitions/schemas.AmountSchema"
                },
                "colorHex": {
                    "type": "string",
                    "example": "#1E88E5"
                },
                "description": {
                    "type": "string",
                    "example": "Main salary card"
                },
                "id": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "localizedAmount": {
                    "description": "LocalizedAmount is Amount converted into the user's own currency, so a\nclient can total accounts that are denominated differently.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/schemas.AmountSchema"
                        }
                    ]
                },
                "name": {
                    "type": "string",
                    "example": "Monobank card"
                }
            }
        },
        "schemas.AccountsBalanceSchema": {
            "type": "object",
            "properties": {
                "accounts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/schemas.AccountSchema"
                    }
                },
                "total": {
                    "$ref": "#/definitions/schemas.AmountSchema"
                }
            }
        },
        "schemas.AmountSchema": {
            "type": "object",
            "properties": {
                "currency": {
                    "type": "string",
                    "example": "uah"
                },
                "value": {
                    "type": "string",
                    "example": "1250.50"
                }
            }
        },
        "schemas.CategorySchema": {
            "type": "object",
            "properties": {
                "hexColor": {
                    "type": "string",
                    "example": "#43A047"
                },
                "icon": {
                    "type": "string",
                    "example": "shopping-cart"
                },
                "id": {
                    "type": "integer",
                    "example": 12
                },
                "name": {
                    "type": "string",
                    "example": "Groceries"
                }
            }
        },
        "schemas.CreateAccountSchema": {
            "type": "object",
            "required": [
                "colorHex",
                "currency",
                "name"
            ],
            "properties": {
                "colorHex": {
                    "type": "string",
                    "maxLength": 7,
                    "example": "#1E88E5"
                },
                "currency": {
                    "type": "string",
                    "example": "uah"
                },
                "defaultValue": {
                    "type": "string",
                    "example": "1250.50"
                },
                "description": {
                    "type": "string",
                    "maxLength": 256,
                    "example": "Main salary card"
                },
                "name": {
                    "type": "string",
                    "maxLength": 64,
                    "example": "Monobank card"
                }
            }
        },
        "schemas.CreateCategorySchema": {
            "type": "object",
            "required": [
                "hexColor",
                "icon",
                "name"
            ],
            "properties": {
                "hexColor": {
                    "description": "HexColor is spelled this way, rather than the accounts colorHex, because\nthat is the key the existing clients send and read.",
                    "type": "string",
                    "maxLength": 64,
                    "example": "#43A047"
                },
                "icon": {
                    "type": "string",
                    "maxLength": 64,
                    "example": "shopping-cart"
                },
                "name": {
                    "type": "string",
                    "maxLength": 64,
                    "example": "Groceries"
                }
            }
        },
        "schemas.CreateTransactionSchema": {
            "type": "object",
            "required": [
                "currency",
                "day",
                "month",
                "title",
                "type",
                "value",
                "year"
            ],
            "properties": {
                "accountId": {
                    "type": "string",
                    "example": "123e4567-e89b-12d3-a456-426614174000"
                },
                "categoryId": {
                    "type": "integer",
                    "example": 1
                },
                "currency": {
                    "type": "string",
                    "example": "uah"
                },
                "day": {
                    "type": "integer",
                    "maximum": 31,
                    "minimum": 1,
                    "example": 12
                },
                "description": {
                    "type": "string",
                    "maxLength": 256,
                    "example": "Weekly shop"
                },
                "month": {
                    "type": "integer",
                    "maximum": 12,
                    "minimum": 1,
                    "example": 9
                },
