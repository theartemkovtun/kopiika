# Copy to .env.local and fill in the Cognito values for your environment.

# --- API -------------------------------------------------------------------
# The bare host: every endpoint is already prefixed /v1.
NEXT_PUBLIC_API_URL=https://kopiika-api-go.onrender.com
# Running kopiika-api-go locally instead:
# NEXT_PUBLIC_API_URL=http://localhost:8080

# --- AWS Cognito -----------------------------------------------------------
# The Go API validates the id token against this pool's JWKS, so it has to be
# the same pool the API is configured with.
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_USER_POOL_DOMAIN=

# Comma-separated; each must be registered as a callback URL on the app client.
NEXT_PUBLIC_COGNITO_OAUTH_REDIRECT_SIGN_IN=http://localhost:3000/external-auth
NEXT_PUBLIC_COGNITO_OAUTH_REDIRECT_SIGN_OUT=http://localhost:3000

# --- Statsig ---------------------------------------------------------------
# Client SDK key (client-…) for product event tracking. Blank turns tracking
# off; the app works the same without it.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=
